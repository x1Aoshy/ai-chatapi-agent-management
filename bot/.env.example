# Plantilla de variables de entorno del bot "Marcos".
# Copiar a .env en /home/ubuntu/api/ y rellenar con los valores reales.
# NUNCA hacer commit del .env resultante.

# --- DeepSeek ---
# Obtener en la consola de DeepSeek. Ver docs/08-seguridad.md
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de inferencia. Si se omite, index.js usa 'deepseek-chat'.
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Chatwoot ---
# Token del AgentBot. Recuperar con:
#   docker exec chatwoot-rails-1 bundle exec rails runner \
#     "puts AgentBot.first.access_token.token"
CHATWOOT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Gateway de docker0 hacia el contenedor de Chatwoot.
# Verificar tras cada reinicio de Docker (ver docs/02-red-y-puertos.md).
CHATWOOT_BASE_URL=http://172.17.0.1:3000

# --- Base de conocimiento (RAG) ---
# Si falta cualquiera de las tres, el RAG queda desactivado y el bot funciona
# solo con instrucciones.txt. No es un fallo: es la degradación prevista.

# Proveedor de embeddings: "openai" (por defecto) o "gemini".
# DeepSeek no ofrece API de embeddings pública, así que los vectores vienen de
# otro sitio aunque la inferencia siga en DeepSeek.
# Debe coincidir con el configurado en el panel.
EMBEDDING_PROVIDER=openai

# Rellena solo la del proveedor elegido.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=

# Supabase. El bot usa la SERVICE ROLE key, no la anónima: necesita saltarse
# RLS para leer el conocimiento sin sesión de usuario.
# Esta clave da acceso total a la base de datos: nunca debe salir del servidor.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
