# Plantilla de variables de entorno del bot "Marcos".
# Copiar a .env en /home/ubuntu/api/ y rellenar con los valores reales.
# NUNCA hacer commit del .env resultante.

# --- DeepSeek ---
# Obtener en la consola de DeepSeek. Ver docs/08-seguridad.md
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de inferencia. Si se omite, index.js usa 'deepseek-chat'.
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Chatwoot ---
# Token del AgentBot. Recuperar con:
#   docker exec chatwoot-rails-1 bundle exec rails runner \
#     "puts AgentBot.first.access_token.token"
CHATWOOT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Gateway de docker0 hacia el contenedor de Chatwoot.
# Verificar tras cada reinicio de Docker (ver docs/02-red-y-puertos.md).
CHATWOOT_BASE_URL=http://172.17.0.1:3000

# --- Redis ---
# Memoria conversacional. Si se omite se usa redis://127.0.0.1:6379.
REDIS_URL=redis://127.0.0.1:6379

# --- Webhook ---
# OPCIONAL pero recomendado. Si se define, /webhook exige la cabecera
# `x-webhook-token` con este valor y rechaza el resto con 401. Sin él,
# cualquiera que alcance el puerto 5000 puede inyectar conversaciones falsas y
# consumir cuota de la API. Configurar el mismo valor en el webhook de Chatwoot.
#   openssl rand -hex 32
WEBHOOK_TOKEN=

# Ruta del prompt del sistema. Por defecto ./instrucciones.txt
INSTRUCTIONS_PATH=
