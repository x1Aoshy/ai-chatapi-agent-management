# Plantilla de variables del panel. Copiar a .env.local para desarrollo.
# NUNCA hacer commit del archivo resultante.

# --- Supabase ---
# Project Settings → API en el dashboard de Supabase.
# La anon key es pública por diseño: la autorización la imponen las políticas
# RLS, no el secreto. Por eso lleva el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Middleware del servidor AWS ---
# URL base del middleware (puerto 5001). Debe ir sobre HTTPS: la API key de
# abajo viaja en cada petición y sobre HTTP plano queda expuesta.
AGENT_API_URL=https://tu-servidor.ejemplo.com

# Clave compartida entre el panel y el middleware.
# SIN prefijo NEXT_PUBLIC_ a propósito: así nunca llega al bundle del navegador.
# Generar con: openssl rand -hex 32
AGENT_API_KEY=

# --- Embeddings (base de conocimiento) ---
# Se usa al guardar un fragmento en /knowledge, para generar su vector.
# Sin prefijo NEXT_PUBLIC_: nunca llega al navegador.
# Sin esta variable, /knowledge muestra un error al guardar.
OPENAI_API_KEY=
