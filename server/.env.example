# Plantilla del middleware. Copiar a .env y rellenar.
# NUNCA hacer commit del .env resultante.

PORT=5001

# --- Clave compartida con el panel ---
# El MISMO valor que AGENT_API_KEY en Vercel.
# Generar con: openssl rand -hex 32
# El servicio no arranca si mide menos de 32 caracteres.
PANEL_API_KEY=

# --- Bot ---
BOT_DIR=/home/ubuntu/api
PM2_PROCESS_NAME=ai-bot

# --- Chatwoot ---
CHATWOOT_BASE_URL=http://172.17.0.1:3000
CHATWOOT_ACCOUNT_ID=2
# Mismo token que usa el bot. Recuperar con:
#   docker exec chatwoot-rails-1 bundle exec rails runner \
#     "puts AgentBot.first.access_token.token"
CHATWOOT_ACCESS_TOKEN=

# --- Evolution API (WhatsApp) ---
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=ventas

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- DeepSeek ---
# Solo para la sonda de estado: se llama a /models, que no consume saldo.
DEEPSEEK_API_KEY=
